---
import type { Solution } from '../data/solutions';
import { statusConfig } from '../data/solutions';

interface Props {
  solution: Solution;
}

const { solution } = Astro.props;
const { label, classes } = statusConfig[solution.status];
const hasDemo = Boolean(solution.demoUrl && solution.demoUrl !== '#');
const hasGitHub = Boolean(solution.githubUrl);

// Fall back to the portfolio's own brand blue when an app has no accent.
const accent = solution.accent ?? { light: '#3a57e8', dark: '#7b9cff' };
const accentVars = `--accent-light: ${accent.light}; --accent-dark: ${accent.dark};`;

// SVG logos are inlined so they can use the card's CSS variables. PNGs are imported so Astro
// builds their URL, including the site's base path.
const svgLogos = import.meta.glob<string>('../assets/logos/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const pngLogos = import.meta.glob<ImageMetadata>('../assets/logos/*.png', {
  import: 'default',
  eager: true,
});
const logo = solution.logo;
const logoSvg = logo ? svgLogos[`../assets/logos/${logo.file}`] : undefined;
const logoSrc = logo ? pngLogos[`../assets/logos/${logo.file}`]?.src : undefined;
---

<article
  class="solution-card card-hover group rounded-2xl border border-gray-100 dark:border-gray-800 bg-white dark:bg-gray-900 p-6 flex flex-col shadow-sm hover:shadow-xl"
  style={accentVars}
>
  <div class="flex items-start justify-between mb-4">
    <div
      class:list={[
        'logo-box accent-tile w-11 h-11 rounded-xl overflow-hidden flex items-center justify-center text-xl',
        { 'p-1.5': logo?.kind === 'glyph' },
      ]}
    >
      {logoSvg ? (
        <Fragment set:html={logoSvg} />
      ) : logoSrc ? (
        <img src={logoSrc} alt={`${solution.name} logo`} class="w-full h-full object-cover rounded-full" />
      ) : (
        solution.icon
      )}
    </div>
    <span class={`inline-flex items-center text-xs font-medium px-2.5 py-1 rounded-full ${classes}`}>
      {label}
    </span>
  </div>

  <h3 class="font-semibold text-base text-gray-900 dark:text-white mb-1">{solution.name}</h3>
  <p class="accent-text text-xs font-medium mb-3">{solution.tagline}</p>
  <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed flex-1 mb-4">
    {solution.description}
  </p>

  <div class="flex flex-wrap gap-1.5 mb-5">
    {solution.tags.map((tag) => (
      <span class="accent-tag text-xs font-medium px-2 py-0.5 rounded border">
        {tag}
      </span>
    ))}
  </div>

  <div class="flex gap-2 mt-auto">
    {hasDemo ? (
      <a
        href={solution.demoUrl}
        target="_blank"
        rel="noopener"
        class="accent-button flex-1 text-center text-xs font-medium py-2 rounded-lg text-white"
      >
        Live Demo
      </a>
    ) : (
      <span class="flex-1 text-center text-xs font-medium py-2 rounded-lg bg-gray-100 dark:bg-gray-800 text-gray-400 dark:text-gray-500 cursor-not-allowed select-none">
        Coming Soon
      </span>
    )}

    {hasGitHub ? (
      <a
        href={solution.githubUrl}
        target="_blank"
        rel="noopener"
        class="flex-1 text-center text-xs font-medium py-2 rounded-lg border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors"
      >
        GitHub
      </a>
    ) : (
      <span class="flex-1 text-center text-xs font-medium py-2 rounded-lg border border-gray-200 dark:border-gray-700 text-gray-400 dark:text-gray-500 cursor-not-allowed select-none">
        GitHub
      </span>
    )}
  </div>
</article>

<style>
  /* --accent follows the theme; the button always uses the darker light-mode
     shade so white text stays readable in both themes. */
  .solution-card {
    --accent: var(--accent-light);
    --red: #cf222e;
  }
  :global(.dark) .solution-card {
    --accent: var(--accent-dark);
    --red: #f85149;
  }

  .logo-box :global(svg) {
    width: 100%;
    height: 100%;
  }

  .solution-card:hover {
    border-color: color-mix(in srgb, var(--accent) 35%, transparent);
    box-shadow: 0 20px 25px -5px color-mix(in srgb, var(--accent) 15%, transparent);
  }

  .accent-tile {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .accent-text {
    color: var(--accent);
  }

  .accent-tag {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    border-color: color-mix(in srgb, var(--accent) 25%, transparent);
  }

  .accent-button {
    background: linear-gradient(
      135deg,
      var(--accent-light),
      color-mix(in srgb, var(--accent-light) 75%, black)
    );
    box-shadow: 0 2px 10px color-mix(in srgb, var(--accent-light) 30%, transparent);
  }
</style>
